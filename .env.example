# ─── Required ────────────────────────────────────────────────
COGNODB_URI=bolt+s://your-cognodb-host:7687
COGNODB_PASSWORD=your-cognodb-password

# ─── Optional ────────────────────────────────────────────────
# Database user (defaults to "neo4j")
COGNODB_USER=neo4j

# Database name (defaults to "neo4j")
COGNODB_DATABASE=neo4j

# Temp directory for cloned repos (defaults to OS temp dir)
# INGEST_CLONE_DIR=/tmp/blast-radius-clones

# Maximum repo size guard in MB (defaults to 200)
# MAX_REPO_SIZE_MB=200

# ─── Legacy fallbacks (accepted if COGNODB_* not set) ────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_PASSWORD=password
# NEO4J_USER=neo4j
